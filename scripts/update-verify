#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_DIR=$(dirname "$SCRIPT_DIR")
PYTHON="$REPO_DIR/.venv/bin/python"
RUFF="$REPO_DIR/.venv/bin/ruff"

if [ ! -x "$PYTHON" ]; then
    echo "Missing virtual environment at $REPO_DIR/.venv" >&2
    exit 1
fi

cd "$REPO_DIR"

echo "==> Ensuring Rich UI dependency is installed"
"$PYTHON" -m pip install 'rich>=13.7,<15'

echo "==> Installing current syncall code into .venv"
"$PYTHON" - <<'PY'
import shutil
import sysconfig
from pathlib import Path

site = Path(sysconfig.get_path("purelib"))
for dist in site.glob("syncall-*.dist-info"):
    if (dist / "RECORD").is_file() and (dist / "METADATA").is_file():
        continue
    print(f"Removing broken package metadata {dist.name}")
    shutil.rmtree(dist)
PY
"$PYTHON" -m pip install --upgrade --force-reinstall --no-deps .

echo "==> Checking dependencies"
"$PYTHON" -m pip check

echo "==> Running full test suite"
"$PYTHON" -m pytest

echo "==> Running Ruff lint checks"
"$RUFF" check syncall tests

echo "==> Running Ruff formatting check"
"$RUFF" format --check syncall tests

echo "==> Everything passed"
